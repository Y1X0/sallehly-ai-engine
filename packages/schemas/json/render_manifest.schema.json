{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sallehly.ai/render_manifest.schema.json",
  "title": "RenderManifest",
  "description": "Output of the Asset Packager (services/export-service): the single record tying together every deliverable produced for a project's final video - the exported video itself, thumbnails, subtitle files, and metadata. This is what gets handed to a caller (frontend/API/CDN upload) as 'the finished thing'.",
  "type": "object",
  "required": ["schema_version", "manifest_id", "project_id", "video", "created_at"],
  "properties": {
    "schema_version": { "type": "string", "const": "1.0" },
    "manifest_id": { "type": "string" },
    "project_id": { "type": "string" },
    "video": {
      "type": "object",
      "required": ["asset_id", "uri", "format", "resolution", "fps", "duration_sec"],
      "properties": {
        "asset_id": { "type": "string" },
        "uri": { "type": "string" },
        "format": { "type": "string", "enum": ["mp4", "mov", "webm"] },
        "resolution": { "type": "string", "pattern": "^[0-9]+x[0-9]+$" },
        "fps": { "type": "integer", "minimum": 1 },
        "duration_sec": { "type": "number", "exclusiveMinimum": 0 },
        "codec": { "type": "string" }
      },
      "additionalProperties": false
    },
    "thumbnails": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["asset_id", "uri"],
        "properties": {
          "asset_id": { "type": "string" },
          "uri": { "type": "string" },
          "kind": { "type": "string", "enum": ["auto", "scene", "keyframe"] },
          "timestamp_sec": { "type": "number", "minimum": 0 }
        },
        "additionalProperties": false
      }
    },
    "subtitles": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["language", "format", "uri"],
        "properties": {
          "language": { "type": "string" },
          "format": { "type": "string", "enum": ["srt", "vtt"] },
          "uri": { "type": "string" },
          "burned_in": { "type": "boolean" }
        },
        "additionalProperties": false
      }
    },
    "metadata": {
      "type": "object",
      "description": "Free-form: logline, aspect_ratio, engine_id, generation timestamps, etc."
    },
    "created_at": { "type": "string", "format": "date-time" }
  },
  "additionalProperties": false
}
