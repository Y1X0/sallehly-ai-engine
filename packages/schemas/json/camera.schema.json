{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.sallehly.ai/camera.schema.json",
  "title": "CameraSetup",
  "description": "Output of the Camera Engine for a single shot: lens, framing, angle, and movement.",
  "type": "object",
  "required": ["shot_type", "movement"],
  "properties": {
    "shot_type": {
      "type": "string",
      "enum": ["extreme_wide", "wide", "medium", "medium_close_up", "close_up", "extreme_close_up", "insert", "pov"]
    },
    "focal_length_mm_equiv": { "type": "number", "minimum": 8, "maximum": 400, "examples": [35] },
    "angle": {
      "type": "string",
      "enum": ["eye_level", "low_angle", "high_angle", "birds_eye", "dutch_tilt", "over_the_shoulder"]
    },
    "movement": {
      "type": "object",
      "required": ["type"],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["static", "pan", "tilt", "dolly_in", "dolly_out", "truck", "crane", "handheld", "steadicam", "zoom_in", "zoom_out", "orbit"]
        },
        "speed": { "type": "string", "enum": ["slow", "medium", "fast"], "default": "medium" },
        "easing": { "type": "string", "enum": ["linear", "ease_in", "ease_out", "ease_in_out"], "default": "ease_in_out" }
      },
      "additionalProperties": false
    },
    "depth_of_field": {
      "type": "string",
      "enum": ["shallow", "medium", "deep"],
      "default": "medium"
    },
    "notes": { "type": "string" }
  },
  "additionalProperties": false
}
