# --- Database ---
DATABASE_URL=postgresql://sallehly:sallehly@localhost:5432/video_engine

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379/0

# --- Object storage (local: MinIO, prod: S3/R2) ---
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=sallehly
STORAGE_SECRET_KEY=sallehly123
STORAGE_BUCKET=video-engine-assets

# --- Workflow engine ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- AI Director / LLM provider (see packages/llm-providers) ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- Video engine (see services/video-engine-adapter) ---
VIDEO_ENGINE=wan2.1
COMPUTE_PROVIDER=local          # local | runpod | vastai

RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

VASTAI_API_KEY=
VASTAI_INSTANCE_HOST=

# --- API (apps/api) ---
# Origins allowed to call apps/api from a browser (apps/web-dashboard's
# own origin) - comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000
