# --- Database ---
DATABASE_URL=postgresql+psycopg://sallehly:sallehly@localhost:5432/video_engine
PROJECT_STORE=memory           # memory | postgres

# --- Cache / Queue ---
REDIS_URL=redis://localhost:6379/0
EVENT_BUS=memory               # memory | redis
TOKEN_STORE=memory             # memory | redis
CACHE_BACKEND=memory           # memory | redis

# --- Object storage (local: MinIO, prod: S3/R2) ---
STORAGE_PROVIDER=local          # local | s3
STORAGE_ENDPOINT_URL=http://localhost:9000
STORAGE_ACCESS_KEY=sallehly
STORAGE_SECRET_KEY=sallehly123
STORAGE_BUCKET=video-engine-assets

# --- Workflow engine ---
TEMPORAL_ADDRESS=localhost:7233
TEMPORAL_NAMESPACE=default

# --- AI Director / LLM provider (see packages/llm-providers) ---
LLM_PROVIDER=claude
ANTHROPIC_API_KEY=

# --- Video engine (see services/video-engine-adapter) ---
VIDEO_ENGINE=wan2.1
# local           = LocalProvider: mock stub, no actual video, no credentials
# local-inference = LocalInferenceProvider: real (never mocked) tiny-scale
#                    WanPipeline generation, in-process - real playable .mp4
#                    per shot, no GPU/credentials needed (see
#                    video_engine_adapter.inference.wan_inference's docstring
#                    for exactly what "tiny-scale" means and doesn't prove)
# runpod          = RunPodProvider: real, full-scale Wan2.2 generation on a
#                    real GPU via a deployed RunPod Serverless endpoint (see
#                    infra/runpod/README.md) - REQUIRES RUNPOD_API_KEY and
#                    RUNPOD_ENDPOINT_ID below; apps/api refuses to start
#                    with a clear error if either is missing, rather than
#                    silently falling back to the mock
# vastai          = VastAIProvider: not yet implemented (Phase 3 target)
COMPUTE_PROVIDER=local          # local | local-inference | runpod | vastai

# Only used when COMPUTE_PROVIDER=local-inference and you want real
# full-scale local inference instead of the default tiny smoke-scale
# path (still requires a real CUDA GPU either way for the non-smoke case).
VIDEO_INFERENCE_SMOKE_TEST=true
VIDEO_INFERENCE_MODEL_ID=
VIDEO_INFERENCE_DEVICE=cpu       # cpu | cuda | auto

RUNPOD_API_KEY=
RUNPOD_ENDPOINT_ID=

VASTAI_API_KEY=
VASTAI_INSTANCE_HOST=

# --- Wan2.2 weights (real HF download + checksum verification, never
# random weights - see services/training/src/training/hf_download.py,
# workers/gpu-worker/handler.py, docs/adr/0024-wan22-real-training-backend.md) ---
# Only needed if the target HF repo (Wan-AI/Wan2.2-*-Diffusers) is or
# becomes gated - verify on the repo's HF page. Not committed anywhere;
# see docs/EXECUTION_PLAN_FIRST_GPU_RUN.md for the full secrets list
# (Kaggle/Modal credentials are configured via their own CLIs, not env vars).
# Not read by apps/api itself - only by services/training/scripts/
# download_wan22_weights.py (local training) and the RunPod worker
# container (infra/runpod/deploy_endpoint.py --hf-token / RUNPOD_ENDPOINT_ID's
# own template env, not this process's environment).
HF_TOKEN=

# --- API (apps/api) ---
# Origins allowed to call apps/api from a browser (apps/web-dashboard's
# own origin) - comma-separated.
CORS_ALLOWED_ORIGINS=http://localhost:3000

# --- Observability (see packages/observability, docs/adr/0019-observability.md) ---
LOG_LEVEL=INFO
OTEL_EXPORTER=console          # console | otlp | none
OTEL_ENDPOINT=
ERROR_REPORTER=logging         # logging | sentry
SENTRY_DSN=

# --- Security hardening (see docs/adr/0020-security-hardening.md) ---
RATE_LIMITER=memory            # memory | redis
AUTH_RATE_LIMIT_PER_MINUTE=20
GENERATION_RATE_LIMIT_PER_MINUTE=10
TOKEN_STORE_TTL_SECONDS=0      # 0 = tokens never expire
UPLOAD_MAX_BYTES=26214400      # 25 MiB
UPLOAD_ALLOWED_CONTENT_TYPES=image/png,image/jpeg,image/webp,image/gif
QUOTA_ENFORCER=memory          # memory | redis
MAX_CONCURRENT_GENERATIONS_PER_WORKSPACE=0  # 0 = unlimited
